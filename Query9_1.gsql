USE GRAPH FullSocialGraph_SF10

CREATE OR REPLACE QUERY Query9_1() FOR GRAPH FullSocialGraph_SF10 SYNTAX v2 {

  SumAccum<INT> @@po = 0;
  positive=
    SELECT tag
    FROM
      Person:person1 -( KNOWS )- Person:person2
      -( KNOWS )- Person:person3
      -( Person_Has_Interest_Tag > )- Tag:tag
    WHERE person1!=person3
    ACCUM @@po +=1;
  PRINT @@po as pocount;
}
